# Supabase project settings
# Copy this file to `.env.local` and fill in the real values.
# Copy with:  cp .env.example .env.local   (PowerShell:  Copy-Item .env.example .env.local)
#
# Where to find each value:
#   Supabase Dashboard -> Project Settings -> API

# Project URL  ->  "Project URL"  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key  ->  "anon public" or "Publishable key"  (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role / secret key  ->  "service_role" or "Secret key"
# NEVER prefix this with NEXT_PUBLIC_. NEVER import it into a Client Component.
# Only `lib/supabase/admin.ts` (server-only) may read this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# URL ของเว็บไซต์ตัวเอง (ไม่มี slash ท้าย)
# ใช้สำหรับสร้างลิงก์ในอีเมลยืนยันบัญชี ให้ผู้สมัครกลับมาที่ /pending
# ตอน dev ใช้ http://localhost:3000 ได้
NEXT_PUBLIC_SITE_URL=http://localhost:3000
